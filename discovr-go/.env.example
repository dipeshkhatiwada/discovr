#############################
# Discovr .env (example)
#
# Copy this file to `.env` and fill in values as needed.
# Then load it in your shell before running discovr:
#   bash/zsh:  set -a; source .env; set +a
#   fish:      for line in (cat .env | string trim | string match -r '^[^#].*'); set -x (string split -m1 '=' $line); end
#
# Notes:
# - Do NOT commit your `.env` file. `.gitignore` excludes it.
# - Discovr reads standard SDK environment variables for cloud providers.
# - For features like Active Directory, pass flags using these env vars when you run:
#     ./discovr --ad --domain "$AD_DOMAIN" --username "$AD_USERNAME" --password "$AD_PASSWORD"

#############################
# General (optional)
#############################
# Default log directory override (same as --log-dir). If unset, Discovr chooses a writable location.
# DISCOVR_LOG_DIR=./discovr_reports/logs

#############################
# AWS (used by aws-sdk-go-v2)
#############################
# If using static credentials (not recommended for long term):
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=

# Profile/region commonly used by `--cloud aws` if flags omitted.
AWS_PROFILE=default
AWS_REGION=us-east-1

#############################
# Azure (used by azidentity DefaultAzureCredential)
#############################
# Subscription is required for Azure discovery. You can also pass via flag `--subscription`.
AZURE_SUBSCRIPTION_ID=

# If using a Service Principal (client secret flow):
# AZURE_TENANT_ID=
# AZURE_CLIENT_ID=
# AZURE_CLIENT_SECRET=

# If using a Service Principal certificate:
# AZURE_CLIENT_CERTIFICATE_PATH=
# AZURE_CLIENT_CERTIFICATE_PASSWORD=

#############################
# GCP (optional; only if building with -tags gcp)
#############################
# Path to a service account JSON key for ADC. Alternatively run:
#   gcloud auth application-default login
# and omit this variable.
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/key.json

# Convenience variables you can pass as flags:
# GCP_PROJECT=
# GCP_ZONE=

#############################
# Active Directory (convenience only; pass as flags when running)
#############################
# AD_DOMAIN=
# AD_USERNAME=
# AD_PASSWORD=

